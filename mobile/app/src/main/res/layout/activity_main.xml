<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:fitsSystemWindows="false">

    <!-- Верхняя компактная панель -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="◀"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <Button
            android:id="@+id/btnReload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🔄"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvShieldStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️"
            android:textColor="@color/accent_green"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnTopToggle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:text="⚙️"
            android:textColor="@color/accent_green"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />

        <Button
            android:id="@+id/btnHideUI"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✕"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Основной контейнер экранов -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Экран 1: Защищенный WebView Мессенджера -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Экран 2: Панель Настроек -->
        <LinearLayout
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_main"
            android:visibility="gone"
            android:orientation="vertical">

            <!-- Компактный заголовок -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@color/bg_surface">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛡️ Настройки"
                    android:textColor="@color/accent_green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSettingsBackToChat"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="💬"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:background="@drawable/round_btn_bg"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <!-- Микрофон -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/card_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎙️ Микрофон"
                            android:textColor="@color/text_main"
                            android:textSize="14sp" />

                        <Switch
                            android:id="@+id/switchMic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/accent_green"
                            android:trackTint="@color/bg_card" />
                    </LinearLayout>

                    <!-- Камера -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/card_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📷 Камера"
                            android:textColor="@color/text_main"
                            android:textSize="14sp" />

                        <Switch
                            android:id="@+id/switchCamera"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/accent_green"
                            android:trackTint="@color/bg_card" />
                    </LinearLayout>

                    <!-- Уведомления -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/card_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔔 Уведомления"
                            android:textColor="@color/text_main"
                            android:textSize="14sp" />

                        <Switch
                            android:id="@+id/switchNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/accent_green"
                            android:trackTint="@color/bg_card" />
                    </LinearLayout>

                    <!-- Невидимка -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/card_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👻 Невидимка"
                            android:textColor="@color/text_main"
                            android:textSize="14sp" />

                        <Switch
                            android:id="@+id/switchGhost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/accent_green"
                            android:trackTint="@color/bg_card" />
                    </LinearLayout>

                    <!-- Режим ПК -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/card_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🖥️ Режим ПК"
                            android:textColor="@color/text_main"
                            android:textSize="14sp" />

                        <Switch
                            android:id="@+id/switchDesktop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/accent_green"
                            android:trackTint="@color/bg_card" />
                    </LinearLayout>

                    <!-- Масштаб -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/card_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🔍 Масштаб"
                            android:textColor="@color/text_main"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnZoomMinus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="−"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            android:background="@drawable/round_btn_bg" />

                        <TextView
                            android:id="@+id/tvZoomValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp" />

                        <Button
                            android:id="@+id/btnZoomPlus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textColor="@color/text_main"
                            android:textSize="16sp"
                            android:background="@drawable/round_btn_bg" />
                    </LinearLayout>

                    <!-- Журнал блокировки (компактный) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒 Блокировка"
                        android:textColor="@color/accent_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_bg"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvBlockedLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Трекеры блокируются автоматически"
                            android:textColor="@color/accent_green"
                            android:fontFamily="monospace"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Кнопка очистки -->
                    <Button
                        android:id="@+id/btnSettingsClear"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🧹 Очистить сессию"
                        android:textColor="#ffffff"
                        android:background="@drawable/btn_danger_bg"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Нижняя панель навигации -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnNavMessenger"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="💬"
            android:textColor="@color/accent_green"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙️"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/btnNavClear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🧹"
            android:textColor="@color/text_main"
            android:textSize="18sp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

</LinearLayout>
