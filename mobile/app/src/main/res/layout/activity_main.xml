<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:fitsSystemWindows="false">

    <!-- Верхняя панель -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="2dp"
        android:paddingRight="2dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="◀"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:contentDescription="Назад"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="▶"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:contentDescription="Вперёд"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <Button
            android:id="@+id/btnReload"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="⟳"
            android:textColor="@color/text_main"
            android:textSize="19sp"
            android:contentDescription="Обновить"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvShieldStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ Защита активна"
            android:textColor="@color/accent_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="4dp"
            android:paddingRight="4dp" />

        <Button
            android:id="@+id/btnTopToggle"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:text="⚙"
            android:textColor="@color/accent_green"
            android:textSize="19sp"
            android:contentDescription="Настройки"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <Button
            android:id="@+id/btnHideUI"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="⤢"
            android:textColor="@color/text_secondary"
            android:textSize="17sp"
            android:contentDescription="Скрыть панели"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Тонкий индикатор загрузки страницы -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/accent_green"
        android:visibility="gone" />

    <!-- Основной контейнер экранов -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Экран 1: защищённый WebView мессенджера -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Экран 2: настройки -->
        <LinearLayout
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_main"
            android:visibility="gone"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@color/bg_surface">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛡️ VirtualMax"
                    android:textColor="@color/accent_green"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSettingsBackToChat"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="💬 В чат"
                    android:textColor="@color/bg_main"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_accent_bg"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="12dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="20dp">

                    <!-- РАЗДЕЛ: ДОСТУП К УСТРОЙСТВУ -->
                    <TextView style="@style/SectionHeader" android:text="ДОСТУП К УСТРОЙСТВУ" />

                    <LinearLayout style="@style/SettingCard">
                        <LinearLayout style="@style/SettingTextBlock">
                            <TextView style="@style/SettingTitle" android:text="🎙️  Микрофон" />
                            <TextView style="@style/SettingSubtitle" android:text="Голосовые сообщения и звонки" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/switchMic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/switch_thumb"
                            android:trackTint="@color/switch_track" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingCard">
                        <LinearLayout style="@style/SettingTextBlock">
                            <TextView style="@style/SettingTitle" android:text="📷  Камера" />
                            <TextView style="@style/SettingSubtitle" android:text="Видеозвонки и отправка фото" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/switchCamera"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/switch_thumb"
                            android:trackTint="@color/switch_track" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingCard">
                        <LinearLayout style="@style/SettingTextBlock">
                            <TextView style="@style/SettingTitle" android:text="🔔  Уведомления" />
                            <TextView style="@style/SettingSubtitle" android:text="Сообщения и звонки в фоне" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/switchNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/switch_thumb"
                            android:trackTint="@color/switch_track" />
                    </LinearLayout>

                    <!-- РАЗДЕЛ: ПРИВАТНОСТЬ -->
                    <TextView style="@style/SectionHeader" android:text="ПРИВАТНОСТЬ" />

                    <LinearLayout style="@style/SettingCard">
                        <LinearLayout style="@style/SettingTextBlock">
                            <TextView style="@style/SettingTitle" android:text="🛡️  Блокировка трекеров" />
                            <TextView style="@style/SettingSubtitle" android:text="VK, Яндекс Метрика, Sentry и другие" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/switchBlocking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/switch_thumb"
                            android:trackTint="@color/switch_track" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingCard">
                        <LinearLayout style="@style/SettingTextBlock">
                            <TextView style="@style/SettingTitle" android:text="👻  Режим Невидимки" />
                            <TextView style="@style/SettingSubtitle" android:text="Скрывает «Печатает…» и присутствие" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/switchGhost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/switch_thumb"
                            android:trackTint="@color/switch_track" />
                    </LinearLayout>

                    <!-- РАЗДЕЛ: ВНЕШНИЙ ВИД -->
                    <TextView style="@style/SectionHeader" android:text="ВНЕШНИЙ ВИД" />

                    <LinearLayout style="@style/SettingCard">
                        <LinearLayout style="@style/SettingTextBlock">
                            <TextView style="@style/SettingTitle" android:text="🖥️  Режим ПК" />
                            <TextView style="@style/SettingSubtitle" android:text="Десктопная версия сайта" />
                        </LinearLayout>
                        <Switch
                            android:id="@+id/switchDesktop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/switch_thumb"
                            android:trackTint="@color/switch_track" />
                    </LinearLayout>

                    <LinearLayout style="@style/SettingCard">
                        <LinearLayout style="@style/SettingTextBlock">
                            <TextView style="@style/SettingTitle" android:text="🔍  Масштаб текста" />
                            <TextView style="@style/SettingSubtitle" android:text="70–160%" />
                        </LinearLayout>
                        <Button
                            android:id="@+id/btnZoomMinus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="−"
                            android:textColor="@color/text_main"
                            android:textSize="18sp"
                            android:background="@drawable/round_btn_bg" />

                        <TextView
                            android:id="@+id/tvZoomValue"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="@color/accent_green"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <Button
                            android:id="@+id/btnZoomPlus"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="+"
                            android:textColor="@color/text_main"
                            android:textSize="18sp"
                            android:background="@drawable/round_btn_bg" />
                    </LinearLayout>

                    <!-- РАЗДЕЛ: ЖУРНАЛ ЗАЩИТЫ -->
                    <TextView style="@style/SectionHeader" android:text="ЖУРНАЛ ЗАЩИТЫ" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_bg"
                        android:padding="14dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvBlockedLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Трекеры блокируются автоматически"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="monospace"
                            android:textSize="11sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSettingsClear"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="🧹  Очистить cookies, кэш и сессию"
                        android:textColor="#ffffff"
                        android:background="@drawable/btn_danger_bg"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="VirtualMax 1.3.0 • нулевой сбор данных"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:layout_marginTop="14dp" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <!-- Плавающая кнопка возврата панелей (после скрытия интерфейса) -->
        <Button
            android:id="@+id/btnRestoreUi"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:text="🛡"
            android:textSize="18sp"
            android:contentDescription="Показать панели VirtualMax"
            android:background="@drawable/fab_bg"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Нижняя панель навигации -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnNavMessenger"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="💬 Чат"
            android:textColor="@color/nav_text"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙️ Настройки"
            android:textColor="@color/nav_text"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/btnNavClear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🧹 Очистка"
            android:textColor="@color/nav_text"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

</LinearLayout>
