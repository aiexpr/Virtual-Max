<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:fitsSystemWindows="false">

    <!-- Верхняя компактная панель -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="◀"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <Button
            android:id="@+id/btnReload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🔄"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/tvShieldStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ VirtualMax: 0"
            android:textColor="@color/accent_green"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnTopToggle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:text="⚙️ Настройки"
            android:textColor="@color/accent_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />
    </LinearLayout>

    <!-- Основной контейнер экранов -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Экран 1: Защищенный WebView Мессенджера -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Экран 2: Панель Настроек, Функций и Гайда -->
        <ScrollView
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_main"
            android:visibility="gone"
            android:padding="16dp"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ VirtualMax — Настройки и Гайд"
                    android:textColor="@color/accent_green"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Приватность и защита от слежки"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="18dp" />

                <!-- Блок 1: Разрешения устройств -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="РАЗРЕШЕНИЯ УСТРОЙСТВ"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Тумблер: Микрофон -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎙️ Микрофон"
                            android:textColor="@color/text_main"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Голосовые сообщения и аудиозвонки"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <Switch
                        android:id="@+id/switchMic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_green"
                        android:trackTint="@color/bg_card" />
                </LinearLayout>

                <!-- Тумблер: Камера -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷 Камера"
                            android:textColor="@color/text_main"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Видеозвонки и съемка фото в чатах"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <Switch
                        android:id="@+id/switchCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_green"
                        android:trackTint="@color/bg_card" />
                </LinearLayout>

                <!-- Тумблер: Уведомления -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="18dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔔 Уведомления"
                            android:textColor="@color/text_main"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Push-уведомления о новых сообщениях"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <Switch
                        android:id="@+id/switchNotifications"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_green"
                        android:trackTint="@color/bg_card" />
                </LinearLayout>

                <!-- Блок 2: Функции приватности -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ПРИВАТНОСТЬ И ИНТЕРФЕЙС"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Тумблер: Режим Невидимки -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👻 Режим Невидимки"
                            android:textColor="@color/text_main"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Скрывать статус «Печатает...» от собеседников"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <Switch
                        android:id="@+id/switchGhost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_green"
                        android:trackTint="@color/bg_card" />
                </LinearLayout>

                <!-- Тумблер: Режим ПК -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🖥️ Режим ПК (Desktop Version)"
                            android:textColor="@color/text_main"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Отображать десктопную версию интерфейса"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <Switch
                        android:id="@+id/switchDesktop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/accent_green"
                        android:trackTint="@color/bg_card" />
                </LinearLayout>

                <!-- Масштаб текста -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="18dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔍 Масштаб текста"
                            android:textColor="@color/text_main"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvZoomValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Текущий масштаб: 100%"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <Button
                        android:id="@+id/btnZoomMinus"
                        android:layout_width="42dp"
                        android:layout_height="38dp"
                        android:text="−"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:background="@drawable/round_btn_bg" />
                    <Button
                        android:id="@+id/btnZoomPlus"
                        android:layout_width="42dp"
                        android:layout_height="38dp"
                        android:text="+"
                        android:textColor="@color/text_main"
                        android:textSize="18sp"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/round_btn_bg" />
                </LinearLayout>

                <!-- Блок 3: Журнал блокировки -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ЖУРНАЛ ЗАБЛОКИРОВАННЫХ ТРЕКЕРОВ"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="18dp">
                    <TextView
                        android:id="@+id/tvBlockedLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Слежка и метрики блокируются в реальном времени."
                        android:textColor="@color/accent_green"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Блок 4: Гайд -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ГАЙД: КАК ЭТО РАБОТАЕТ"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Блокировка слежки и трекеров\nVirtualMax фильтрует каждый сетевой запрос на уровне Android WebView. Запросы к трекерам VK/Mail.ru (top-fwz1, counter.yadro, stat.vk.com), Яндекс Метрике, WebVisor, Sentry и внутренним метрикам MAX уничтожаются до выхода в интернет.\n\n2. Анти-Фингерпринт песочница\nВстроенный слой JavaScript защищает процессор и память смартфона от сбора уникального отпечатка, а также нейтрализует скрытые маяки sendBeacon.\n\n3. Переключатели разрешений\nЕсли тумблер Микрофона или Камеры выключен, сайт физически не может получить доступ к датчикам устройства.\n\n4. Очистка следов\nКнопка «Очистить сессию» полностью удаляет все Cookies, LocalStorage и кэш мессенджера."
                        android:textColor="@color/text_main"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <!-- Кнопки действий -->
                <Button
                    android:id="@+id/btnSettingsClear"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="🧹 Очистить все cookies и кэш"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_danger_bg"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnSettingsBackToChat"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="💬 Вернуться в мессенджер"
                    android:textColor="#070a0f"
                    android:background="@drawable/btn_primary_bg"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Нижняя панель навигации -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnNavMessenger"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="💬 Мессенджер"
            android:textColor="@color/accent_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⚙️ Настройки"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:background="?android:attr/selectableItemBackground" />

        <Button
            android:id="@+id/btnNavClear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="🧹 Сброс"
            android:textColor="@color/text_main"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

</LinearLayout>
