{
  "name": "virtualmax-desktop",
  "productName": "VirtualMax",
  "version": "1.2.0",
  "description": "Приватный защищенный клиент-песочница для мессенджера МАКС (web.max.ru) на ПК (Windows, Linux, macOS)",
  "homepage": "https://github.com/aiexpr/Virtual-Max",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build:all": "electron-builder -mwl",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "keywords": [
    "max-messenger",
    "privacy",
    "anti-telemetry",
    "anti-tracking",
    "desktop-client",
    "sandboxed-browser",
    "ghost-mode"
  ],
  "author": {
    "name": "VirtualMax Project",
    "email": "virtualmax@example.com"
  },
  "license": "AGPL-3.0",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.virtualmax.desktop",
    "productName": "VirtualMax",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VirtualMax"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Network;Chat;InstantMessaging",
      "maintainer": "VirtualMax Project <virtualmax@example.com>"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking"
    }
  }
}
